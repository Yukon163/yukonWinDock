<Window x:Class="YukonWinDock.Views.ControlPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="yukonWinDock 控制面板" Width="410" Height="690" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" KeyDown="PanelKeyDown">
 <Border Background="#202429" BorderBrush="#41474F" BorderThickness="1" CornerRadius="12" Padding="22,18,22,16">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,17" MouseLeftButtonDown="DragHeader">
    <StackPanel><TextBlock Text="yukonWinDock" FontWeight="SemiBold" FontSize="21" /><TextBlock Text="你的任务栏，更多可能。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel>
    <Button Content="显示项目" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,34,0" Padding="8,5" Click="OpenDisplayOptions" />
    <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,2" FontSize="19" Background="Transparent" Click="ClosePanel" AutomationProperties.Name="收起控制面板" />
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,7,0">
     <Grid><TextBlock Text="外接显示器" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" /><Button x:Name="RefreshButton" Content="刷新" HorizontalAlignment="Right" Padding="10,4" Click="RefreshMonitors" /></Grid>
     <ComboBox x:Name="MonitorChoice" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,11,0,8" SelectionChanged="MonitorChanged" AutomationProperties.Name="选择外接显示器" />
     <Grid Margin="0,3,0,0"><TextBlock Text="亮度" VerticalAlignment="Center" /><TextBlock x:Name="BrightnessValue" Text="—" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" /></Grid>
     <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,8,0,8" ValueChanged="SliderChanged" AutomationProperties.Name="外接显示器硬件亮度" />
     <UniformGrid Columns="6" Margin="0,0,0,8"><Button Content="10" Tag="10" Margin="0,0,4,0" Padding="0,6" Click="Preset" /><Button Content="20" Tag="20" Margin="0,0,4,0" Padding="0,6" Click="Preset" /><Button Content="40" Tag="40" Margin="0,0,4,0" Padding="0,6" Click="Preset" /><Button Content="60" Tag="60" Margin="0,0,4,0" Padding="0,6" Click="Preset" /><Button Content="80" Tag="80" Margin="0,0,4,0" Padding="0,6" Click="Preset" /><Button Content="100" Tag="100" Padding="0,6" Click="Preset" /></UniformGrid>
     <TextBlock x:Name="BrightnessStatus" Text="正在检测显示器…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" MinHeight="18" />
     <Border Height="1" Background="#383E46" Margin="0,18,0,15" />
     <TextBlock Text="实时状态" FontSize="14" FontWeight="SemiBold" />
     <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="29" /><RowDefinition Height="29" /><RowDefinition Height="29" /><RowDefinition Height="29" /></Grid.RowDefinitions>
      <TextBlock Text="下载 / 上传" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="NetworkValue" Grid.Column="1" Text="正在采样…" FontFamily="Consolas" />
      <TextBlock Grid.Row="1" Text="CPU 频率 / 占用" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="CpuValue" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="Consolas" />
      <TextBlock Grid.Row="2" Text="内存占用" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="MemoryValue" Grid.Row="2" Grid.Column="1" Text="—" FontFamily="Consolas" />
      <TextBlock Grid.Row="3" Text="风扇转速" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="FanValue" Grid.Row="3" Grid.Column="1" Text="— RPM" FontFamily="Consolas" />
     </Grid>
     <TextBlock x:Name="CpuModel" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
     <TextBlock x:Name="FanStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,7" />
     <Button x:Name="AdminButton" Content="以管理员身份重启，读取风扇" HorizontalAlignment="Left" Padding="10,6" Click="RestartAdmin" />
     <TextBlock Text="网速来源" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" FontSize="11" />
     <ComboBox x:Name="NetworkChoice" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="NetworkChanged" AutomationProperties.Name="选择网速采样网卡" />
     <Border Height="1" Background="#383E46" Margin="0,18,0,15" />
     <Grid><TextBlock Text="快捷操作" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="＋ 添加" HorizontalAlignment="Right" Padding="10,4" Click="AddAction" /></Grid>
     <TextBlock x:Name="ActionsEmpty" Text="添加常用程序、文件夹或网址。" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" FontSize="11" />
     <StackPanel x:Name="ActionList" Margin="0,8,0,0" />
     <Border Height="1" Background="#383E46" Margin="0,17,0,15" />
     <Expander x:Name="DisplayOptions" Header="任务栏显示内容（全部可选）" Foreground="#DDE2E8" IsExpanded="True">
      <StackPanel Margin="0,10,0,0">
       <UniformGrid Columns="2"><CheckBox x:Name="ShowDownload" Content="下载速度" Click="ModulesChanged" /><CheckBox x:Name="ShowUpload" Content="上传速度" Click="ModulesChanged" /><CheckBox x:Name="ShowCpuSpeed" Content="CPU 频率" Click="ModulesChanged" /><CheckBox x:Name="ShowCpuUsage" Content="CPU 占用率" Click="ModulesChanged" /><CheckBox x:Name="ShowMemory" Content="内存占用率" Click="ModulesChanged" /><CheckBox x:Name="ShowBrightness" Content="外接屏亮度" Click="ModulesChanged" /><CheckBox x:Name="ShowFan1" Content="风扇 1 转速" Click="ModulesChanged" /><CheckBox x:Name="ShowFan2" Content="风扇 2 转速" Click="ModulesChanged" /></UniformGrid>
       <TextBlock Text="向左偏移（避开任务栏图标）" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
       <Slider x:Name="OffsetSlider" Minimum="-600" Maximum="0" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,6" ValueChanged="OffsetChanged" AutomationProperties.Name="任务栏小工具水平偏移" />
       <CheckBox x:Name="Startup" Content="登录 Windows 时启动" Click="StartupChanged" />
       <TextBlock Text="仅在本地保存设置；无后台上传。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
      </StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" Margin="0,13,0,0"><CheckBox x:Name="KeepOpen" Content="保持展开" Margin="0" FontSize="11" /><Button Content="退出" HorizontalAlignment="Right" Padding="9,3" Background="Transparent" Foreground="{StaticResource MutedBrush}" Click="Quit" /></Grid>
  </Grid>
 </Border>
</Window>
