<Window x:Class="YukonWinDock.Views.DockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="yukonWinDock" Height="40" Width="336" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
  <Border x:Name="Surface" CornerRadius="5" Padding="6,1" Background="#F21B1D20" Cursor="Hand" MouseLeftButtonUp="OpenPanel" ToolTip="yukonWinDock · 点击展开控制面板">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <StackPanel x:Name="NetworkGroup" Width="101" AutomationProperties.Name="实时上传和下载网速">
        <TextBlock x:Name="Download" Text="↓  — KB/s" FontSize="11" FontFamily="Consolas" Foreground="#E5F9F0" />
        <TextBlock x:Name="Upload" Text="↑  — KB/s" FontSize="11" FontFamily="Consolas" Foreground="#A7B1BA" />
      </StackPanel>
      <StackPanel x:Name="CpuGroup" Width="83" AutomationProperties.Name="CPU 频率和占用率">
        <TextBlock x:Name="CpuSpeed" Text="— GHz" FontSize="11" FontFamily="Consolas" />
        <TextBlock x:Name="CpuLoad" Text="CPU  —%" FontSize="10" Foreground="#A7B1BA" />
      </StackPanel>
      <StackPanel x:Name="MemoryGroup" Width="66" AutomationProperties.Name="内存占用率">
        <TextBlock x:Name="MemoryText" Text="—%" FontSize="11" FontFamily="Consolas" />
        <TextBlock Text="内存" FontSize="10" Foreground="#A7B1BA" />
      </StackPanel>
      <StackPanel x:Name="FanGroup" Width="100" AutomationProperties.Name="风扇转速">
        <TextBlock x:Name="FanOne" Text="F1 — RPM" FontSize="11" FontFamily="Consolas" />
        <TextBlock x:Name="FanTwo" Text="F2 — RPM" FontSize="11" FontFamily="Consolas" Foreground="#A7B1BA" />
      </StackPanel>
      <TextBlock x:Name="EmptyLauncher" Text="Y" FontSize="15" FontWeight="SemiBold" Foreground="#7ADBB4" Width="20" TextAlignment="Center" Visibility="Collapsed" ToolTip="点击打开 yukonWinDock" />
      <StackPanel x:Name="BrightnessGroup" Width="61" MouseWheel="AdjustBrightness" ToolTip="外接屏亮度 · 滚轮每次调节 5% · 点击展开">
        <TextBlock x:Name="BrightnessText" Text="☼ —%" FontSize="11" FontFamily="Consolas" Foreground="#7ADBB4" />
        <TextBlock Text="外接屏" FontSize="10" Foreground="#A7B1BA" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
